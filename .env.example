# Copy to .env and fill in. Avoid a literal $ in values (Docker Compose would interpolate it; escape as $$).
PORT=5001
DATABASE=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Host port nginx listens on. Defaults: 3000 locally (compose.yml), 80 on EC2 (compose.ec2.yml).
# CLIENT_PORT=3000

# EC2 only: image tag to run, e.g. sha-a90ede6 to roll back. Defaults to latest.
# IMAGE_TAG=latest

# Only needed for the dev server or a separately hosted client (comma-separated)
# CORS_ORIGINS=http://localhost:3000
